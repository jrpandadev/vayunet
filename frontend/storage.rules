rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{userId}/{reportId}/evidence/{fileName} {
      // Users can only upload and read evidence for their own reports
      // Path variable 'userId' must match the authenticated uid
      allow read: if request.auth != null && request.auth.uid == userId;

      // Enforce file size limit (e.g. 5MB) and image types
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
