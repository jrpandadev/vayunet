{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VayuNetPollutionEvent",
  "description": "Frozen locked event schema from Master Architecture Doc §11",
  "type": "object",
  "required": [
    "event_id",
    "location",
    "timestamp",
    "evidence",
    "correlation",
    "detection",
    "forecast",
    "risk",
    "source_hypothesis",
    "explanation",
    "response",
    "outcome",
    "timeline"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "required": ["lat", "lng", "city"],
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "city": { "type": "string" }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "required": ["citizen", "sensor", "satellite", "weather"],
      "properties": {
        "citizen": {
          "type": "object",
          "required": ["gemini_output", "photo_url", "source", "freshness"],
          "properties": {
            "gemini_output": {
              "type": "object",
              "required": ["event_type", "severity", "confidence", "description", "needs_human_review"],
              "properties": {
                "event_type": { "type": "string" },
                "severity": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "description": { "type": "string" },
                "needs_human_review": { "type": "boolean" }
              }
            },
            "photo_url": { "type": ["string", "null"] },
            "source": { "type": "string" },
            "freshness": { "type": "string" }
          }
        },
        "sensor": {
          "type": "object",
          "required": ["pm25", "pm10", "anomaly_score", "source", "station_id", "quality"],
          "properties": {
            "pm25": { "type": "number" },
            "pm10": { "type": "number" },
            "anomaly_score": { "type": "number", "minimum": 0, "maximum": 1 },
            "source": { "type": "string" },
            "station_id": { "type": "string" },
            "quality": { "type": "string" }
          }
        },
        "satellite": {
          "type": "object",
          "required": ["no2_index", "aerosol_index", "source", "freshness"],
          "properties": {
            "no2_index": { "type": "number" },
            "aerosol_index": { "type": "number" },
            "source": { "type": "string" },
            "freshness": { "type": "string" }
          }
        },
        "weather": {
          "type": "object",
          "required": ["wind_speed_kmh", "humidity_percent", "source"],
          "properties": {
            "wind_speed_kmh": { "type": "number" },
            "humidity_percent": { "type": "number" },
            "source": { "type": "string" }
          }
        }
      }
    },
    "correlation": {
      "type": "object",
      "required": ["duplicate_of", "supporting_reports_count"],
      "properties": {
        "duplicate_of": { "type": ["string", "null"] },
        "supporting_reports_count": { "type": "integer", "minimum": 0 }
      }
    },
    "detection": {
      "type": "object",
      "required": ["confidence", "method", "supporting_evidence", "contradicting_evidence"],
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string" },
        "supporting_evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contradicting_evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "forecast": {
      "type": "object",
      "required": ["pm25_6h", "pm25_24h", "pm25_72h", "spike_probability", "forecast_uncertainty"],
      "properties": {
        "pm25_6h": { "type": "number" },
        "pm25_24h": { "type": "number" },
        "pm25_72h": { "type": "number" },
        "spike_probability": { "type": "string" },
        "forecast_uncertainty": { "type": "string" }
      }
    },
    "risk": {
      "type": "string"
    },
    "source_hypothesis": {
      "type": "object",
      "required": ["category", "confidence"],
      "properties": {
        "category": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "explanation": {
      "type": "string"
    },
    "response": {
      "type": "object",
      "required": ["alert_sent", "authority_class", "status"],
      "properties": {
        "alert_sent": { "type": "boolean" },
        "authority_class": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "outcome": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "event"],
        "properties": {
          "time": { "type": "string" },
          "event": { "type": "string" }
        }
      }
    }
  },
  "example": {
    "event_id": "string",
    "location": { "lat": 0.0, "lng": 0.0, "city": "delhi" },
    "timestamp": "ISO8601",
    "evidence": {
      "citizen": {
        "gemini_output": {
          "event_type": "smoke",
          "severity": "high",
          "confidence": 0.82,
          "description": "Dense smoke visible near industrial area",
          "needs_human_review": false
        },
        "photo_url": "string",
        "source": "citizen",
        "freshness": "fresh"
      },
      "sensor": {
        "pm25": 180,
        "pm10": 240,
        "anomaly_score": 0.8,
        "source": "CPCB",
        "station_id": "DPCC_AnandVihar",
        "quality": "verified"
      },
      "satellite": {
        "no2_index": 18.2,
        "aerosol_index": 1.3,
        "source": "Sentinel-5P",
        "freshness": "contextual"
      },
      "weather": {
        "wind_speed_kmh": 2.0,
        "humidity_percent": 80,
        "source": "open_meteo"
      }
    },
    "correlation": { "duplicate_of": null, "supporting_reports_count": 1 },
    "detection": {
      "confidence": 0.83,
      "method": "weighted_fusion_v1",
      "supporting_evidence": ["sensor", "citizen"],
      "contradicting_evidence": []
    },
    "forecast": {
      "pm25_6h": 195,
      "pm25_24h": 210,
      "pm25_72h": 180,
      "spike_probability": "HIGH",
      "forecast_uncertainty": "MEDIUM"
    },
    "risk": "CRITICAL",
    "source_hypothesis": { "category": "biomass_burning", "confidence": 0.71 },
    "explanation": "Risk is CRITICAL because PM2.5 has risen significantly above baseline, satellite confirms elevated NO2, and low wind speed prevents dispersion. Likely source: biomass burning (confidence 0.71).",
    "response": {
      "alert_sent": true,
      "authority_class": "pollution_control_board",
      "status": "acknowledged"
    },
    "outcome": "confirmed",
    "timeline": [
      { "time": "23:10", "event": "sensor_anomaly_detected" },
      { "time": "23:17", "event": "citizen_report_received" },
      { "time": "23:20", "event": "gemini_analysis_completed" },
      { "time": "23:25", "event": "satellite_signal_retrieved" },
      { "time": "23:27", "event": "event_classified_HIGH" },
      { "time": "23:30", "event": "authority_alert_sent" }
    ]
  }
}
